# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- Django ---
# Required. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Dev: true   Laptop: false
DJANGO_DEBUG=true
# Default: localhost,127.0.0.1. Django always adds `web` (the Docker service name) and the
# host of FILAMENTS_PUBLIC_URL itself.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Usually empty: the origin of FILAMENTS_PUBLIC_URL is added automatically.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Dev: empty (console only)   Laptop: set by compose.yaml to /app/logs/django.log
DJANGO_LOG_FILE=

# --- Filaments ---
# Required, at least 32 characters. The MCP server sends it as a bearer token to the API.
# Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
FILAMENTS_API_TOKEN=
# Where the MCP server reaches the API. Default http://127.0.0.1:8000/api (the Compose
# web service from the host). In Compose (step 9) the mcp service uses http://web:8000/api.
FILAMENTS_API_URL=
# Public base URL of this server: the OAuth issuer Claude signs in to. Default
# http://127.0.0.1:8000 for local testing; the https tunnel URL in step 9.
FILAMENTS_PUBLIC_URL=
# The MCP server's OAuth client, for checking Claude's tokens at /o/introspect/ (used
# from step 9). Printed once by: manage.py setup_oauth_clients
FILAMENTS_INTROSPECTION_CLIENT_ID=
FILAMENTS_INTROSPECTION_CLIENT_SECRET=
# Where the MCP server checks tokens. Default http://web:8000/o/introspect/ (the Docker
# network); never routed through the tunnel.
FILAMENTS_INTROSPECTION_URL=
# Only for testing --http on one machine with FILAMENTS_PUBLIC_URL=http://127.0.0.1:8080.
# Never set this on the laptop.
FILAMENTS_ALLOW_INSECURE_PUBLIC_URL=

# --- Cloudflare Tunnel (laptop only; `docker compose --profile public up -d`) ---
# From Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel. Treat like a password.
CLOUDFLARE_TUNNEL_TOKEN=
# Home timezone (IANA name). Timestamps are stored in UTC; this decides what a
# calendar day means for date filters. Defaults to UTC if unset; a typo stops startup.
FILAMENTS_TIMEZONE=America/Chicago

# --- PostgreSQL ---
# Used by the db container and by Django.
POSTGRES_DB=filaments
POSTGRES_USER=filaments
POSTGRES_PASSWORD=
# Dev (runserver/pytest on the Mac): localhost   In Compose: overridden to db
POSTGRES_HOST=localhost
# Host port the db container publishes on 127.0.0.1, and the port Django uses
# from the host. Use another port (e.g. 5433) if a local Postgres already has 5432.
# Inside Compose, web always uses 5432.
POSTGRES_PORT=5432
