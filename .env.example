# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- Django ---
# Required. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Dev: true   Laptop: false
DJANGO_DEBUG=true
# Dev: localhost,127.0.0.1   Laptop: localhost,127.0.0.1,web (tunnel hostname added in step 9)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Dev: empty   Laptop: https://<tunnel-hostname> (step 9)
DJANGO_CSRF_TRUSTED_ORIGINS=
# Dev: empty (console only)   Laptop: set by compose.yaml to /app/logs/django.log
DJANGO_LOG_FILE=

# --- PostgreSQL ---
# Used by the db container and by Django.
POSTGRES_DB=filaments
POSTGRES_USER=filaments
POSTGRES_PASSWORD=
# Dev (runserver/pytest on the Mac): localhost   In Compose: overridden to db
POSTGRES_HOST=localhost
# Host port the db container publishes on 127.0.0.1, and the port Django uses
# from the host. Use another port (e.g. 5433) if a local Postgres already has 5432.
# Inside Compose, web always uses 5432.
POSTGRES_PORT=5432
